# Required
OPENROUTER_API_KEY=your_openrouter_key_here
UPSTAGE_API_KEY=your_upstage_key_here

# Models / endpoints
JEV_MODEL=typesafe/jev-1.13
JEV_URL=https://openrouter.ai/api/alpha/decisions
SOLAR_MODEL=solar-pro3
SOLAR_URL=https://api.upstage.ai/v1/chat/completions

# Runtime
REQUEST_TIMEOUT=90
MAX_HISTORY_TURNS=8
DEBUG=0

# Jev candidate records evaluated per Decisions request (1-20)
JEV_BATCH_SIZE=8

# Legacy fragment-controller settings (:legacy only)
FAST_GUIDED_STEPS=1
FULL_GUIDED_STEPS=3
ADAPTIVE_MAX_GUIDED_STEPS=6
DEFAULT_RUN_MODE=fast
